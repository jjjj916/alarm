{
  "cleanUrls": true,
  "functions": {
    "api/cron-check.js": { "maxDuration": 30 },
    "api/push-cron.js": { "maxDuration": 30 },
    "api/push.js": { "maxDuration": 30 },
    "api/server-time.js": { "maxDuration": 15 }
  },
  "headers": [
    { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
